<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback Configuration for Kaptur Backend
    =========================================
    Uses logback-spring.xml (not logback.xml) so we can leverage Spring Boot features:
    - <springProperty> to read values from application.properties
    - <springProfile> to activate different configs per environment

    Appenders:
    - CONSOLE: Colored output for local development
    - FILE: Rolling file appender for production (daily rotation, 30-day retention)
-->
<configuration>

    <!-- Read application name from Spring properties -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="kaptur"/>

    <!-- ======================== -->
    <!-- Console Appender (Color) -->
    <!-- ======================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%15.15thread] %cyan(%-40.40logger{39}) : %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- =================================== -->
    <!-- Rolling File Appender (Production)  -->
    <!-- =================================== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Roll over daily, with max 10MB per file -->
            <fileNamePattern>logs/${APP_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %-40.40logger{39} : %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- =========================================== -->
    <!-- Reduce noise from verbose framework loggers -->
    <!-- =========================================== -->

    <!-- Hibernate SQL logging (controlled separately from show-sql in application.properties) -->
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>

    <!-- Spring framework noise reduction -->
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.boot.devtools" level="WARN"/>
    <logger name="org.springframework.boot.autoconfigure" level="INFO"/>

    <!-- Database connection pool -->
    <logger name="com.zaxxer.hikari" level="INFO"/>

    <!-- Tomcat / embedded server -->
    <logger name="org.apache.catalina" level="INFO"/>
    <logger name="org.apache.tomcat" level="INFO"/>

    <!-- Google API client (OAuth2 token verification) -->
    <logger name="com.google.api.client" level="WARN"/>

    <!-- ======================== -->
    <!-- Application Log Levels   -->
    <!-- ======================== -->
    <logger name="com.koustav.kaptur" level="DEBUG"/>

    <!-- ================ -->
    <!-- Profile: dev     -->
    <!-- Active by default when no profile is set or spring.profiles.active=dev -->
    <!-- ================ -->
    <springProfile name="dev | default">
        <logger name="com.koustav.kaptur" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ================ -->
    <!-- Profile: prod    -->
    <!-- ================ -->
    <springProfile name="prod">
        <logger name="com.koustav.kaptur" level="INFO"/>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- ================ -->
    <!-- Profile: test    -->
    <!-- ================ -->
    <springProfile name="test">
        <logger name="com.koustav.kaptur" level="DEBUG"/>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
